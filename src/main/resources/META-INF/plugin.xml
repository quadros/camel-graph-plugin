<idea-plugin>
    <id>com.github.gquad.camelgraph</id>
    <name>Camel Graph Visualization</name>
    <version>1.0.1</version>
    <vendor email="gquadross@gmail.com" url="https://github.com/gquad">GQuad</vendor>

    <description><![CDATA[
    Visualizes Apache Camel routes defined in Java DSL.<br>
    Parses your source code to generate a graph of routes, endpoints, and processors.
    ]]></description>

    <!-- please see https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html
         on how to target different products -->
    <idea-version since-build="232" until-build="251.*" />
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Add your extensions here -->
        <toolWindow id="CamelGraph" secondary="true" anchor="right"
                    factoryClass="com.example.camelgraph.ui.CamelGraphToolWindowFactory"/>
    </extensions>

    <actions>
        <!-- Add your actions here -->
    </actions>
</idea-plugin>
